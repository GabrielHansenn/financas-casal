# Copy to .env.local and fill in. Local values come from `npx supabase status`.
# Only the URL and the PUBLISHABLE key go here. The secret key (sb_secret_...) is NOT used by the app
# and must never be exposed to the client.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public URL of the app (used in invite links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMTP for invite emails. Locally: Mailpit on 127.0.0.1:54325 (no auth).
# Production: any SMTP provider (e.g. Resend: smtp.resend.com, port 465, secure=true).
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Finanças Casal <nao-responda@financas.local>"
